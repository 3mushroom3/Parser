# Server Settings
PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-random-string-at-least-32-chars-long

# Database
DB_PATH=./data/fsa_parser.db

# FSA Parser Config
FSA_BASE_URL=https://pub.fsa.gov.ru
FSA_CRON_SCHEDULE=*/30 * * * *
FSA_PAGE_SIZE=100
FSA_FETCH_CONCURRENCY=3
FSA_DELAY_MS=1500
# FSA_DATE_FROM/FSA_DATE_CHUNK — не задавайте для обычной работы: без них живой
# API сам сканирует только текущий месяц (историю закрывают открытые данные РДС
# ниже). Задавайте оба вместе только для ручного бэкафилла диапазона дат.
# FSA_DATE_FROM=2024-01-01
# FSA_DATE_CHUNK=week

# Открытые данные РДС (история деклараций, без лимита пагинации FSA API)
FSA_OPENDATA_CRON=15 2 * * *

# Опционально: обход банов FSA WAF (Solar JSOC) при резком росте нагрузки
# FSA_PROXY_URL=socks5://user:pass@host:port
# FSA_LOCAL_ADDRESS=

# FNS / Dadata API
# Get your token at https://dadata.ru/
DADATA_TOKEN=

# Logging
LOG_LEVEL=info

# ЮКасса (получить в личном кабинете: https://yookassa.ru/my/shop-settings/integration)
# Тестовый магазин выдаёт ключ с префиксом test_ — оплата тестовыми картами.
# Вебхук (Интеграция → HTTP-уведомления): https://<домен>/api/payment/webhook,
# события payment.succeeded и payment.canceled.
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
# Кассовый чек 54-ФЗ: on (ООО/ИП с фискализацией) или off (самозанятые)
YUKASSA_RECEIPT=on
# Ставка НДС в чеке (справочник ЮKassa): 1 — без НДС, 4 — 20%, 11 — 22%
YUKASSA_VAT_CODE=1

# URL сайта (для редиректа после оплаты и вебхуков)
APP_URL=https://your-domain.ru

# Цены тарифных планов (в рублях)
PLAN_IND_1M=1000
PLAN_3M_PRICE=2490
PLAN_12M_PRICE=7990
PLAN_GROUP_YEAR=30000

# Resend (транзакционные письма — код подтверждения email при регистрации)
# Ключ: личный кабинет Resend → API Keys. MAIL_FROM_EMAIL должен быть на
# домене, подтверждённом в Resend (Domains → Add Domain → DNS-записи).
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=KOVELIA

# Бот в MAX (dev.max.ru) — напоминания по заметкам + подписки на новые
# декларации. Токен и имя бота — в личном кабинете после регистрации бота.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_BOT_API_URL=https://platform-api2.max.ru
